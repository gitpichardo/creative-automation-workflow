# --- ImageKit ---
# https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# https://imagekit.io/dashboard/url-endpoints
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Webhook signing secret from https://imagekit.io/dashboard/developer/webhooks
# (starts with "whsec_"). Optional -- only needed if you configure a webhook
# in the ImageKit dashboard pointing at this app's /webhooks/imagekit route.
# Without it, video variants fall back to polling instead of webhook-assisted
# waiting -- see README, "Async transformation protocol".
IMAGEKIT_WEBHOOK_SECRET=

# --- Render Key Value (the `state` service in render.yaml) ---
# Render injects this automatically via `fromService` when deployed from
# render.yaml. For local dev, point it at any Redis/Valkey instance, e.g.
# `docker run -p 6379:6379 valkey/valkey` then REDIS_URL=redis://localhost:6379
REDIS_URL=redis://localhost:6379

# --- Render Workflows ---
# API key the `api` service uses to trigger runs of the `campaign-workflow`
# service. Create one at https://dashboard.render.com/u/settings#api-keys --
# see README, "Deploying the workflow service" for why this can't be
# provisioned by render.yaml yet.
RENDER_API_KEY=rnd_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Slug of the deployed workflow service, e.g. "creative-automation-workflow".
# Task slugs are then `<WORKFLOW_SLUG>/<task-name>`.
WORKFLOW_SLUG=creative-automation-workflow

# --- api service ---
PORT=3000
# This service's own public URL, used only to print the exact webhook URL to
# register in the ImageKit dashboard (e.g. https://creative-automation-api.onrender.com).
PUBLIC_BASE_URL=http://localhost:3000

# Safety caps -- see README, "Limits"
MAX_ASSETS_PER_CAMPAIGN=200
AWAIT_TRANSFORMATION_TIMEOUT_MS=120000
